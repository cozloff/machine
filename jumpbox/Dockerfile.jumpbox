FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Pacific/Honolulu
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Normal interactive shell for debugging inside the container.
    bash \
    \
    # Trusted root certificates so HTTPS works for curl, wget, git, rustup, APIs, etc.
    ca-certificates \
    \
    # HTTP/API testing and downloading files from URLs.
    curl \
    wget \
    \
    # Source control; useful for cloning repos or inspecting mounted projects.
    git \
    \
    # SSH client only; lets the jumpbox connect out to servers/Git remotes.
    openssh-client \
    \
    # JSON parser; essential for reading API responses and CLI output cleanly.
    jq \
    \
    # Pager for reading long logs/configs without dumping everything at once.
    less \
    \
    # Small editors for emergency edits inside the container.
    nano \
    vim-tiny \
    \
    # Core network inspection: interfaces, routes, sockets via ip/ss.
    iproute2 \
    \
    # Provides ping for basic ICMP reachability tests.
    iputils-ping \
    \
    # DNS debugging tools like dig and nslookup.
    dnsutils \
    \
    # Path/routing inspection to see where packets travel.
    traceroute \
    \
    # TCP port testing and simple raw socket checks via nc.
    netcat-openbsd \
    \
    # Packet capture for deeper Docker/network debugging.
    tcpdump \
    \
    # Process inspection tools like ps, top, free, uptime.
    procps \
    \
    # Shows which processes have files/ports open.
    lsof \
    \
    # Identifies file types, binaries, archives, certs, etc.
    file \
    \
    # Common archive extraction.
    unzip \
    xz-utils \
    \
    # Native compiler/toolchain base; useful for Rust crates with C/C++ build deps.
    build-essential \
    \
    # Lets build scripts discover native libraries and compiler/linker flags.
    pkg-config \
    \
    # OpenSSL headers/libs; many Rust/network/TLS crates need this unless using rustls.
    libssl-dev \
    \
    # GPG tooling for importing Microsoft’s package signing key.
    gnupg \
    \
    # Detects the Ubuntu codename, e.g. noble, for the Azure CLI apt repo, keyring directory, and other distro-specific setup.
    lsb-release \
    && mkdir -p /etc/apt/keyrings \
    \
    # Download Microsoft’s package signing key silently and pipe it to gpg to create a keyring file, then set permission to read-only for all users.
    && curl -sL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > /etc/apt/keyrings/microsoft.gpg \
    && chmod go+r /etc/apt/keyrings/microsoft.gpg \
    \
    # Set up distro codename (noble) -> Azure CLI apt repo and update package lists, then install the Azure CLI and verify installation by printing its version.
    && AZ_DIST="$(lsb_release -cs)" \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/azure-cli/ ${AZ_DIST} main" \
        > /etc/apt/sources.list.d/azure-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends azure-cli \
    && az version \
    \
    # Install Rust using rustup with the minimal profile to save space, and set the default toolchain to stable. 
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable \
    \
    # After installation, clean up apt lists to reduce image size.
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/machine

# Copy the CLI source code and Cargo files into the container
COPY Cargo.toml Cargo.lock ./
COPY cli ./cli

# Then build and install the CLI using cargo install with the --force flag to ensure it overwrites any existing installation.
RUN cargo install --path . --force

WORKDIR /workspace

CMD ["sleep", "infinity"]
