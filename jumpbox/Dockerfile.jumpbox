FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Pacific/Honolulu
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV NVIM_VERSION=stable
ENV PATH=/usr/local/cargo/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Normal interactive shell for debugging inside the container.
    bash \
    \
    # Trusted root certificates so HTTPS works for curl, wget, git, rustup, APIs, etc.
    ca-certificates \
    \
    # HTTP/API testing and downloading files from URLs.
    curl wget \
    \
    # Source control; useful for cloning repos or inspecting mounted projects.
    git \
    \
    # SSH client only; lets the jumpbox connect out to servers/Git remotes.
    openssh-client \
    \
    # JSON parser; essential for reading API responses and CLI output cleanly.
    jq \
    \
    # Pagers, fuzzy finding, and fast search for shell and Neovim workflows.
    less fzf ripgrep fd-find \
    \
    # Small editors for emergency edits inside the container.
    nano vim-tiny \
    \
    # Core network inspection: interfaces, routes, sockets via ip/ss.
    iproute2 \
    \
    # Provides ping for basic ICMP reachability tests.
    iputils-ping \
    \
    # DNS debugging tools like dig and nslookup.
    dnsutils \
    \
    # Path/routing inspection to see where packets travel.
    traceroute \
    \
    # TCP port testing and simple raw socket checks via nc.
    netcat-openbsd \
    \
    # Packet capture for deeper Docker/network debugging.
    tcpdump \
    \
    # Process inspection tools like ps, top, free, uptime.
    procps \
    \
    # Shows which processes have files/ports open.
    lsof \
    \
    # Identifies file types, binaries, archives, certs, etc.
    file \
    \
    # Common archive extraction.
    unzip xz-utils tar gzip \
    \
    # Native compiler/toolchain base; useful for Rust crates with C/C++ build deps.
    build-essential cmake clang clangd \
    \
    # Lets build scripts discover native libraries and compiler/linker flags.
    pkg-config \
    \
    # OpenSSL headers/libs; many Rust/network/TLS crates need this unless using rustls.
    libssl-dev \
    \
    # LazyVim/Mason language tooling foundations. 
    nodejs npm python3 python3-pip python3-venv python3-pynvim luarocks \
    \
    # Install OpenAI Codex CLI globally with npm.
    && npm install -g @openai/codex \
    \
    # Create a symlink for fdfind to fd
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    \
    # Install Neovim from the official GitHub releases. 
    && curl -fsSL "https://github.com/neovim/neovim/releases/download/${NVIM_VERSION}/nvim-linux-x86_64.tar.gz" \
    | tar -xz -C /opt \
    && ln -s /opt/nvim-linux-x86_64/bin/nvim /usr/local/bin/nvim \
    && ln -s /usr/local/bin/nvim /usr/local/bin/vim \
    && ln -s /usr/local/bin/nvim /usr/local/bin/vi \
    \
    # Install Kubernetes client tooling used against the k3s service.
    && curl -fsSL https://dl.k8s.io/release/stable.txt \
    | xargs -I{} curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/{}/bin/linux/amd64/kubectl" \
    && chmod +x /usr/local/bin/kubectl \
    && curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 \
    | bash \
    \
    # Set up a basic Neovim config by cloning the LazyVim starter template.
    && git clone --filter=blob:none https://github.com/LazyVim/starter /root/.config/nvim \
    && rm -rf /root/.config/nvim/.git \
    && mkdir -p /root/.local/share/nvim /root/.local/state/nvim /root/.cache/nvim \
    && nvim --headless "+Lazy! sync" +qa \
    # Install Rust using rustup with the minimal profile to save space, and set the default toolchain to stable.
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable \
    \
    # Clean up apt cache to reduce image size.
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/machine

# Copy the CLI source code and Cargo files into the container
COPY Cargo.toml Cargo.lock ./
COPY cli ./cli

# Then build and install the CLI using cargo install with the --force flag to ensure it overwrites any existing installation.
RUN cargo install --path . --force

WORKDIR /workspace

CMD ["sleep", "infinity"]
